---
import { SITE_CONFIG } from "../config";

const githubUsername = SITE_CONFIG.name || "nivinvysakh";
---

<!-- Single Unified PR & Activity Widget Card -->
<div class="dracula-glass rounded-xl p-4 sm:p-6 border border-dracula-selection/30 flex flex-col gap-5 relative overflow-hidden transition-all duration-300">
  
  <!-- Header Bar with Integrated Tab Switcher -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-dracula-selection/40 pb-4">
    <div class="flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-dracula-pink animate-pulse"></span>
      <h2 class="font-mono text-xs sm:text-sm font-bold text-dracula-fg tracking-wide flex items-center gap-2">
        <span>PR & ACTIVITY LOG</span>
        <span class="text-[10px] text-dracula-comment font-normal hidden sm:inline">(@{githubUsername})</span>
      </h2>
    </div>

    <div class="flex items-center justify-between sm:justify-end gap-2">
      <!-- Interactive Tab Toggle -->
      <div class="flex items-center gap-1 bg-dracula-bgDarker/80 p-1 rounded-lg border border-dracula-selection/40 font-mono text-xs">
        <button
          id="tab-btn-prs"
          type="button"
          class="px-3 py-1 rounded-md text-dracula-fg bg-dracula-selection font-bold transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-dracula-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
          </svg>
          <span>Pull Requests</span>
        </button>

        <button
          id="tab-btn-events"
          type="button"
          class="px-3 py-1 rounded-md text-dracula-comment hover:text-dracula-fg transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5 text-dracula-pink" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Activity Feed</span>
        </button>
      </div>

      <a
        href={`https://github.com/${githubUsername}`}
        target="_blank"
        rel="noopener noreferrer"
        title="View GitHub Profile"
        class="font-mono text-xs text-dracula-cyan hover:underline hidden md:inline-block ml-2"
      >
        GitHub ↗
      </a>
    </div>
  </div>

  <!-- Tab Panel 1: Pull Requests -->
  <div id="panel-prs" class="space-y-3 block transition-all duration-300">
    <div id="pr-list-container" class="space-y-3">
      <div class="py-8 text-center text-dracula-comment font-mono text-xs flex items-center justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-dracula-purple animate-ping"></span>
        Fetching Pull Requests...
      </div>
    </div>
  </div>

  <!-- Tab Panel 2: Activity Feed -->
  <div id="panel-events" class="space-y-3 hidden transition-all duration-300">
    <div id="activity-feed-container" class="space-y-3">
      <div class="py-8 text-center text-dracula-comment font-mono text-xs flex items-center justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-dracula-pink animate-ping"></span>
        Fetching Activity Feed...
      </div>
    </div>
  </div>

  <!-- Footer Link inside Widget -->
  <div class="flex items-center justify-between border-t border-dracula-selection/30 pt-3 font-mono text-[11px] text-dracula-comment">
    <span>Live GitHub REST API</span>
    <a href="/activity" class="text-dracula-purple hover:text-dracula-pink hover:underline font-bold transition-colors">
      View Full Activity Page →
    </a>
  </div>
</div>

<script is:inline define:vars={{ githubUsername }}>
  // Relative Date Formatting Helper
  function timeAgo(dateString) {
    const date = new Date(dateString);
    const now = new Date();
    const seconds = Math.floor((now.getTime() - date.getTime()) / 1000);
    if (seconds < 60) return "just now";
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return `${minutes}m ago`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    return `${days}d ago`;
  }

  function extractRepoName(urlOrName) {
    if (!urlOrName) return "";
    return urlOrName.replace("https://api.github.com/repos/", "");
  }

  // Interactive Tab Switcher Setup
  const tabPrs = document.getElementById("tab-btn-prs");
  const tabEvents = document.getElementById("tab-btn-events");
  const panelPrs = document.getElementById("panel-prs");
  const panelEvents = document.getElementById("panel-events");

  if (tabPrs && tabEvents && panelPrs && panelEvents) {
    tabPrs.addEventListener("click", () => {
      panelPrs.classList.remove("hidden");
      panelPrs.classList.add("block");
      panelEvents.classList.remove("block");
      panelEvents.classList.add("hidden");

      tabPrs.className =
        "px-3 py-1 rounded-md text-dracula-fg bg-dracula-selection font-bold transition-all flex items-center gap-1.5";
      tabEvents.className =
        "px-3 py-1 rounded-md text-dracula-comment hover:text-dracula-fg transition-all flex items-center gap-1.5";
    });

    tabEvents.addEventListener("click", () => {
      panelEvents.classList.remove("hidden");
      panelEvents.classList.add("block");
      panelPrs.classList.remove("block");
      panelPrs.classList.add("hidden");

      tabEvents.className =
        "px-3 py-1 rounded-md text-dracula-fg bg-dracula-selection font-bold transition-all flex items-center gap-1.5";
      tabPrs.className =
        "px-3 py-1 rounded-md text-dracula-comment hover:text-dracula-fg transition-all flex items-center gap-1.5";
    });
  }

  // Fetch Pull Requests
  async function loadPullRequests() {
    const container = document.getElementById("pr-list-container");
    if (!container) return;

    try {
      const res = await fetch(
        `https://api.github.com/search/issues?q=author:${githubUsername}+type:pr&sort=created&order=desc&per_page=6`
      );

      if (!res.ok) throw new Error(`API status ${res.status}`);
      const data = await res.json();
      const prs = data.items || [];

      if (prs.length === 0) {
        container.innerHTML = `
          <div class="py-6 text-center font-mono text-xs text-dracula-comment">
            No recent pull requests found for @${githubUsername}.
          </div>
        `;
        return;
      }

      container.innerHTML = prs
        .map((pr) => {
          const isMerged = Boolean(pr.pull_request && pr.pull_request.merged_at);
          const isClosed = pr.state === "closed" && !isMerged;

          let badgeClass = "bg-dracula-green/20 text-dracula-green border-dracula-green/40";
          let badgeLabel = "OPEN";

          if (isMerged) {
            badgeClass = "bg-dracula-purple/20 text-dracula-purple border-dracula-purple/40";
            badgeLabel = "MERGED";
          } else if (isClosed) {
            badgeClass = "bg-dracula-red/20 text-dracula-red border-dracula-red/40";
            badgeLabel = "CLOSED";
          }

          const repoName = extractRepoName(pr.repository_url);

          return `
            <a
              href="${pr.html_url}"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-dracula-bgDarker/60 rounded-lg p-3 border border-dracula-selection/30 hover:border-dracula-purple/50 transition-all block group"
            >
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 mb-1.5">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded border ${badgeClass}">
                    ${badgeLabel}
                  </span>
                  <span class="font-mono text-xs text-dracula-cyan group-hover:underline">
                    ${repoName}
                  </span>
                </div>
                <span class="font-mono text-[11px] text-dracula-comment">
                  ${timeAgo(pr.created_at)}
                </span>
              </div>
              <h3 class="font-sans text-xs sm:text-sm font-semibold text-dracula-fg group-hover:text-dracula-pink transition-colors">
                ${pr.title}
              </h3>
            </a>
          `;
        })
        .join("");
    } catch (err) {
      console.warn("⚠️ Unable to load GitHub PRs:", err);
      container.innerHTML = `
        <div class="py-4 text-center font-mono text-xs text-dracula-orange">
          Unable to fetch PRs at this moment.
        </div>
      `;
    }
  }

  // Fetch Activity Feed
  async function loadActivityFeed() {
    const container = document.getElementById("activity-feed-container");
    if (!container) return;

    try {
      const res = await fetch(`https://api.github.com/users/${githubUsername}/events?per_page=6`);
      if (!res.ok) throw new Error(`API status ${res.status}`);
      const events = await res.json();

      if (!Array.isArray(events) || events.length === 0) {
        container.innerHTML = `
          <div class="py-6 text-center font-mono text-xs text-dracula-comment">
            No recent activity recorded.
          </div>
        `;
        return;
      }

      container.innerHTML = events
        .map((event) => {
          let actionText = "Contributed to";
          let badgeColor = "text-dracula-cyan border-dracula-cyan/30 bg-dracula-cyan/10";
          let detail = "";

          switch (event.type) {
            case "PushEvent":
              actionText = "Pushed commits to";
              badgeColor = "text-dracula-green border-dracula-green/30 bg-dracula-green/10";
              const commits = event.payload?.commits || [];
              if (commits.length > 0) {
                detail = commits[0].message;
              }
              break;
            case "PullRequestEvent":
              const prAction = event.payload?.action || "updated";
              actionText = `${prAction.toUpperCase()} pull request in`;
              badgeColor = "text-dracula-purple border-dracula-purple/30 bg-dracula-purple/10";
              detail = event.payload?.pull_request?.title || "";
              break;
            case "CreateEvent":
              const refType = event.payload?.ref_type || "repo";
              actionText = `Created ${refType} in`;
              badgeColor = "text-dracula-pink border-dracula-pink/30 bg-dracula-pink/10";
              break;
            case "IssueCommentEvent":
              actionText = "Commented in";
              badgeColor = "text-dracula-yellow border-dracula-yellow/30 bg-dracula-yellow/10";
              break;
            case "WatchEvent":
              actionText = "Starred repository";
              badgeColor = "text-dracula-orange border-dracula-orange/30 bg-dracula-orange/10";
              break;
            default:
              actionText = `${event.type.replace("Event", "")} in`;
          }

          const repoName = event.repo?.name || "";
          const repoUrl = `https://github.com/${repoName}`;

          return `
            <div class="bg-dracula-bgDarker/60 rounded-lg p-3 border border-dracula-selection/30 flex items-start gap-3">
              <span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded border ${badgeColor} shrink-0 mt-0.5">
                ${event.type.replace("Event", "")}
              </span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2 flex-wrap mb-0.5">
                  <div class="font-mono text-xs text-dracula-fg truncate">
                    ${actionText} <a href="${repoUrl}" target="_blank" rel="noopener noreferrer" class="text-dracula-cyan hover:underline font-bold">${repoName}</a>
                  </div>
                  <span class="font-mono text-[11px] text-dracula-comment shrink-0">
                    ${timeAgo(event.created_at)}
                  </span>
                </div>
                ${detail ? `<p class="font-mono text-xs text-dracula-comment line-clamp-1 italic">"${detail}"</p>` : ""}
              </div>
            </div>
          `;
        })
        .join("");
    } catch (err) {
      console.warn("⚠️ Unable to load GitHub activity feed:", err);
      container.innerHTML = `
        <div class="py-4 text-center font-mono text-xs text-dracula-orange">
          Unable to fetch activity feed at this moment.
        </div>
      `;
    }
  }

  loadPullRequests();
  loadActivityFeed();
</script>
