---
import { SITE_CONFIG } from "../config";

const stations = SITE_CONFIG.radioStations || [];
---

<div id="dracula-radio-root" data-stations={JSON.stringify(stations)}>
  <!-- Hidden HTML5 Audio Element for Direct Web Streams -->
  <audio id="dracula-radio-audio" preload="none" crossorigin="anonymous"></audio>

  <!-- YouTube Audio/Video Stream Container (Invisible offscreen, active in DOM) -->
  <div
    id="dracula-radio-yt-wrapper"
    class="fixed -bottom-96 -right-96 w-64 h-64 pointer-events-none opacity-0 z-0 overflow-hidden"
    aria-hidden="true"
  >
    <div id="dracula-radio-yt-player"></div>
  </div>

  <!-- Mini Floating Radio Pill (Persistent Bottom-Right) -->
  <div
    id="radio-mini-dock"
    class="fixed bottom-4 right-4 z-40 flex flex-col rounded-2xl bg-dracula-bgDarker/95 backdrop-blur-xl border border-dracula-purple/40 shadow-2xl font-mono text-xs transition-all duration-300 hover:border-dracula-cyan/60 overflow-hidden select-none"
    role="region"
    aria-label="Dracula Cyber Radio"
  >
    <!-- Mini Radio Main Content -->
    <div class="flex items-center gap-2 p-2">
      <!-- Station Thumbnail & Info (Click opens full tuner deck) -->
      <button
        id="mini-deck-toggle-btn"
        type="button"
        class="flex items-center gap-2.5 px-1.5 py-1 rounded-xl hover:bg-dracula-selection/40 transition-colors text-left focus:outline-none cursor-pointer"
        title="Open Dracula Cyber Radio Deck"
      >
        <!-- Station Art with Pulsing Radio Wave -->
        <div class="relative w-9 h-9 rounded-lg overflow-hidden flex-shrink-0 border border-dracula-purple/50 bg-dracula-card">
          <img
            id="mini-station-logo"
            src={stations[0]?.logo || "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=100&auto=format&fit=crop&q=60"}
            alt="Radio Logo"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div
            id="mini-radio-wave"
            class="hidden absolute inset-0 rounded-full border-2 border-dracula-cyan/60 animate-ping opacity-75"
            style="animation-duration: 2.5s;"
          ></div>
        </div>

        <div class="max-w-[120px] sm:max-w-[170px] truncate">
          <div class="flex items-center gap-1.5">
            <span id="mini-station-freq" class="text-[9px] font-bold text-dracula-pink bg-dracula-pink/15 px-1 py-0.2 rounded">
              {stations[0]?.frequency || "88.5 FM"}
            </span>
            <!-- Live Infinity Sign / Song Badge -->
            <span id="mini-live-badge" class="text-[9px] font-bold text-dracula-green flex items-center gap-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-dracula-green animate-pulse inline-block"></span>
              <span id="mini-live-text">LIVE ∞</span>
            </span>
          </div>
          <span id="mini-station-name" class="text-[11px] text-dracula-fg font-bold truncate block mt-0.5">
            {stations[0]?.name || "Lofi Girl Radio"}
          </span>
        </div>
      </button>

      <!-- Mini Equalizer Animation (Active when playing) -->
      <div id="mini-equalizer" class="hidden sm:flex items-end gap-[2px] h-3 px-1 opacity-40">
        <span class="w-[2px] bg-dracula-green rounded-full h-1 mini-eq-1"></span>
        <span class="w-[2px] bg-dracula-green rounded-full h-2 mini-eq-2"></span>
        <span class="w-[2px] bg-dracula-green rounded-full h-1 mini-eq-3"></span>
        <span class="w-[2px] bg-dracula-green rounded-full h-3 mini-eq-4"></span>
      </div>

      <!-- Quick Controls -->
      <div class="flex items-center gap-1">
        <!-- Prev Station -->
        <button
          id="mini-prev-btn"
          type="button"
          aria-label="Previous Station"
          class="hidden sm:flex p-1.5 rounded-lg text-dracula-comment hover:text-dracula-fg hover:bg-dracula-selection/40 transition-colors focus:outline-none cursor-pointer"
          title="Previous Station"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
          </svg>
        </button>

        <!-- Play / Pause Button -->
        <button
          id="mini-play-btn"
          type="button"
          aria-label="Play or Pause Radio"
          class="w-8 h-8 rounded-xl bg-dracula-purple/20 hover:bg-dracula-purple text-dracula-purple hover:text-dracula-bgDarker border border-dracula-purple/50 flex items-center justify-center transition-all focus:outline-none cursor-pointer shadow-sm"
        >
          <svg id="mini-play-icon" class="w-4 h-4 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z" />
          </svg>
          <svg id="mini-pause-icon" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
          </svg>
          <svg id="mini-loading-icon" class="w-4 h-4 hidden animate-spin text-dracula-yellow" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
        </button>

        <!-- Next Station -->
        <button
          id="mini-next-btn"
          type="button"
          aria-label="Next Station"
          class="p-1.5 rounded-lg text-dracula-comment hover:text-dracula-fg hover:bg-dracula-selection/40 transition-colors focus:outline-none cursor-pointer"
          title="Next Station"
        >
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
          </svg>
        </button>

        <!-- Expand Deck Button -->
        <button
          id="mini-expand-btn"
          type="button"
          aria-label="Expand Radio Deck"
          class="p-1.5 rounded-lg text-dracula-comment hover:text-dracula-pink transition-colors focus:outline-none cursor-pointer"
          title="Open Full Radio Tuner"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mini Bottom Scrubber Bar -->
    <div class="w-full h-1 bg-dracula-selection/40 overflow-hidden">
      <div id="mini-progress-bar" class="h-full bg-gradient-to-r from-dracula-purple to-dracula-pink w-0 transition-all duration-150"></div>
    </div>
  </div>

  <!-- Full Dracula Cyber Radio Tuner Deck (Expanded Modal / Widget) -->
  <div
    id="radio-deck-panel"
    class="hidden fixed bottom-18 right-4 sm:right-6 z-50 w-[calc(100vw-2rem)] sm:w-[480px] max-h-[85vh] overflow-y-auto dracula-card rounded-2xl p-5 shadow-2xl border-2 border-dracula-purple/50 bg-dracula-bgDarker/95 backdrop-blur-2xl transition-all duration-300 font-mono text-xs"
    role="dialog"
    aria-label="Dracula Cyber Radio Tuner"
  >
    <!-- Deck Header -->
    <div class="flex items-center justify-between border-b border-dracula-selection/50 pb-3 mb-3">
      <div class="flex items-center gap-2">
        <span class="text-base">📻</span>
        <div>
          <h2 class="font-bold text-dracula-fg text-sm flex items-center gap-1.5">
            <span>DRACULA</span>
            <span class="text-dracula-pink">CYBER</span>
            <span class="text-dracula-cyan">RADIO</span>
          </h2>
          <span class="text-[10px] text-dracula-comment">PASTE ANY YOUTUBE LINK • 24/7 BROADCAST</span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <!-- Live Status Pill -->
        <div id="deck-status-pill" class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-dracula-selection/40 border border-dracula-selection text-[10px] text-dracula-comment">
          <span id="deck-status-dot" class="w-1.5 h-1.5 rounded-full bg-dracula-comment"></span>
          <span id="deck-status-text">STANDBY</span>
        </div>

        <!-- Close Button -->
        <button
          id="deck-close-btn"
          type="button"
          aria-label="Minimize Radio"
          class="p-1 rounded-lg text-dracula-comment hover:text-dracula-fg hover:bg-dracula-selection/40 transition-colors focus:outline-none cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- PROMINENT YOUTUBE LINK TUNER INPUT (Front & Center) -->
    <div class="mb-4 bg-gradient-to-r from-dracula-purple/15 to-dracula-pink/15 p-2.5 rounded-2xl border border-dracula-purple/40 shadow-md">
      <div class="flex items-center justify-between text-[10px] font-bold text-dracula-pink mb-1.5 px-1">
        <span class="flex items-center gap-1.5">
          <span>⚡</span>
          <span>PASTE YOUTUBE LINK (SONG OR LIVE STREAM)</span>
        </span>
        <span class="text-[9px] text-dracula-cyan">Auto-detects Live / Song</span>
      </div>

      <form id="custom-station-form" class="flex gap-1.5">
        <input
          id="custom-station-input"
          type="text"
          placeholder="Paste YouTube song link, livestream URL, or ID..."
          class="flex-1 bg-dracula-bgDarker border border-dracula-purple/50 rounded-xl px-3 py-2 text-[11px] text-dracula-fg placeholder:text-dracula-comment/60 focus:outline-none focus:border-dracula-pink shadow-inner"
        />
        <button
          type="submit"
          class="px-3.5 py-2 bg-gradient-to-r from-dracula-purple to-dracula-pink text-dracula-bgDarker font-bold rounded-xl text-[10px] hover:scale-105 active:scale-95 transition-all shadow-md flex-shrink-0 cursor-pointer flex items-center gap-1"
        >
          <span>TUNE</span>
          <span>▶</span>
        </button>
      </form>
    </div>

    <!-- Retro Frequency Dial Scale -->
    <div class="mb-3.5 bg-[#111218] p-2.5 rounded-xl border border-dracula-selection/40 overflow-hidden relative">
      <div class="flex items-center justify-between text-[9px] text-dracula-comment mb-1 font-mono">
        <span class="text-dracula-cyan">FM FREQUENCY</span>
        <span id="deck-frequency-display" class="font-bold text-dracula-pink text-xs">
          {stations[0]?.frequency || "88.5 FM"}
        </span>
        <span class="text-dracula-green font-bold flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-dracula-green animate-pulse"></span>
          STEREO
        </span>
      </div>

      <!-- Frequency Tick Marks -->
      <div class="relative h-6 bg-dracula-bgDarker rounded-lg border border-dracula-selection/50 flex items-center justify-between px-3 overflow-hidden">
        {stations.map((st, idx) => (
          <button
            type="button"
            data-station-index={idx}
            class="freq-tick-btn group flex flex-col items-center justify-center h-full px-1 hover:text-dracula-pink focus:outline-none cursor-pointer"
            title={`${st.name} (${st.frequency})`}
          >
            <span class="w-[2px] h-3 bg-dracula-comment/60 group-hover:bg-dracula-pink group-hover:h-4 transition-all"></span>
            <span class="text-[7px] text-dracula-comment group-hover:text-dracula-fg">{st.frequency.replace(" FM", "")}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Now Playing Station Stage -->
    <div class="dracula-glass rounded-2xl p-4 border border-dracula-selection/60 bg-[#16171f] relative overflow-hidden mb-3.5 shadow-inner">
      <!-- Glow Backlight -->
      <div class="absolute -top-12 -right-12 w-40 h-40 bg-dracula-purple/15 rounded-full blur-2xl pointer-events-none"></div>

      <div class="flex gap-4 items-center">
        <!-- Station Logo -->
        <div class="relative group flex-shrink-0">
          <div class="w-20 h-20 sm:w-22 sm:h-22 rounded-2xl overflow-hidden border-2 border-dracula-purple/50 shadow-xl bg-dracula-card">
            <img
              id="deck-station-logo"
              src={stations[0]?.logo || "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=200&auto=format&fit=crop&q=60"}
              alt="Station Logo"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
        </div>

        <!-- Station Metadata -->
        <div class="min-w-0 flex-1 space-y-1">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span
              id="deck-badge"
              class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-dracula-purple/20 text-dracula-purple border border-dracula-purple/30 uppercase"
            >
              {stations[0]?.type === "youtube" ? "YOUTUBE LIVE" : "LIVE STREAM"}
            </span>

            <!-- Live Infinity Badge (Displays ∞ for Live streams) -->
            <span
              id="deck-live-inf-badge"
              class="text-[9px] font-bold px-1.5 py-0.5 rounded bg-dracula-green/20 text-dracula-green border border-dracula-green/30 flex items-center gap-1"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-dracula-green animate-pulse"></span>
              <span>LIVE ∞</span>
            </span>

            <span id="deck-station-genre" class="text-[10px] text-dracula-comment truncate">
              {stations[0]?.genre || "Lofi Hip Hop"}
            </span>
          </div>

          <h3 id="deck-station-name" class="font-bold text-dracula-fg text-sm sm:text-base truncate drop-shadow-sm">
            {stations[0]?.name || "Lofi Girl Radio"}
          </h3>
          <p id="deck-station-desc" class="text-[11px] text-dracula-comment leading-relaxed line-clamp-2">
            {stations[0]?.description || "24/7 peaceful beats to relax, study & write code to"}
          </p>
        </div>
      </div>

      <!-- Scrubber / Seek Bar (Active for songs, shows Live indicator for streams) -->
      <div class="mt-3.5 space-y-1.5">
        <input
          id="deck-seek-slider"
          type="range"
          min="0"
          max="100"
          value="0"
          step="0.1"
          class="w-full h-1.5 bg-dracula-selection rounded-lg appearance-none cursor-pointer accent-dracula-pink focus:outline-none"
          aria-label="Track scrubber"
        />
        <div class="flex items-center justify-between text-[10px] text-dracula-comment font-mono">
          <span id="deck-time-current">0:00</span>
          <!-- Live Infinity duration display -->
          <span id="deck-time-total" class="font-bold text-dracula-cyan flex items-center gap-1">
            <span>LIVE</span>
            <span class="text-sm font-extrabold text-dracula-pink">∞</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Main Playback Controls Bar -->
    <div class="flex items-center justify-between gap-3 mb-3 bg-dracula-selection/20 p-2.5 rounded-2xl border border-dracula-selection/30">
      <!-- Prev Station -->
      <button
        id="deck-prev-btn"
        type="button"
        aria-label="Previous Station"
        class="p-2.5 rounded-xl text-dracula-fg hover:text-dracula-cyan hover:bg-dracula-selection/60 transition-colors focus:outline-none cursor-pointer flex items-center gap-1 text-xs"
        title="Previous Station"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
        </svg>
        <span class="hidden sm:inline text-[10px] text-dracula-comment">PREV</span>
      </button>

      <!-- Primary Big Play/Pause Button -->
      <button
        id="deck-play-btn"
        type="button"
        aria-label="Play or Pause Station"
        class="w-12 h-12 rounded-2xl bg-gradient-to-r from-dracula-purple to-dracula-pink text-dracula-bgDarker font-bold flex items-center justify-center hover:scale-105 shadow-lg shadow-dracula-purple/25 transition-all active:scale-95 focus:outline-none cursor-pointer"
      >
        <svg id="deck-play-icon" class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <svg id="deck-pause-icon" class="w-6 h-6 fill-current hidden" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>
        <svg id="deck-loading-icon" class="w-6 h-6 hidden animate-spin text-dracula-bgDarker" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
      </button>

      <!-- Next Station -->
      <button
        id="deck-next-btn"
        type="button"
        aria-label="Next Station"
        class="p-2.5 rounded-xl text-dracula-fg hover:text-dracula-cyan hover:bg-dracula-selection/60 transition-colors focus:outline-none cursor-pointer flex items-center gap-1 text-xs"
        title="Next Station"
      >
        <span class="hidden sm:inline text-[10px] text-dracula-comment">NEXT</span>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
        </svg>
      </button>
    </div>

    <!-- Accurate Rectangular Graphic Equalizer (Under Controls) -->
    <div
      id="deck-floating-eq-bars"
      class="relative py-2 px-3 mb-3 rounded-xl bg-[#0f1015] border border-dracula-purple/30 shadow-inner overflow-hidden select-none"
      title="Accurate Real-Time Graphic Equalizer"
      aria-hidden="true"
    >
      <!-- Frequency Range Headers -->
      <div class="flex items-center justify-between text-[8px] text-dracula-comment/60 font-mono uppercase tracking-wider mb-1 px-0.5">
        <span class="flex items-center gap-1 text-dracula-green"><span class="w-1.5 h-1.5 bg-dracula-green inline-block"></span> 60Hz</span>
        <span>250Hz</span>
        <span class="text-dracula-yellow">1kHz</span>
        <span>4kHz</span>
        <span class="flex items-center gap-1 text-dracula-pink">16kHz <span class="w-1.5 h-1.5 bg-dracula-pink inline-block"></span></span>
      </div>

      <!-- Canvas for Crisp Rectangular LED Segment Bars -->
      <canvas
        id="deck-eq-canvas"
        class="w-full h-9 block"
      ></canvas>
    </div>

    <!-- Volume Slider Row -->
    <div class="flex items-center gap-3 mb-3.5 px-1">
      <button
        id="deck-mute-btn"
        type="button"
        aria-label="Mute Volume"
        class="text-dracula-comment hover:text-dracula-fg transition-colors focus:outline-none cursor-pointer"
      >
        <svg id="deck-vol-icon-on" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z" />
        </svg>
        <svg id="deck-vol-icon-off" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z" />
        </svg>
      </button>

      <input
        id="deck-volume-slider"
        type="range"
        min="0"
        max="100"
        value="75"
        class="flex-1 h-1.5 bg-dracula-selection rounded-lg appearance-none cursor-pointer accent-dracula-purple focus:outline-none"
        aria-label="Volume Slider"
      />

      <span id="deck-volume-label" class="text-[10px] text-dracula-comment w-8 text-right font-mono">
        75%
      </span>
    </div>

    <!-- Radio Stations & Song Presets -->
    <div class="border-t border-dracula-selection/40 pt-3">
      <div class="flex items-center justify-between text-[10px] text-dracula-comment mb-2">
        <span class="font-bold uppercase tracking-wider text-dracula-fg/90 flex items-center gap-1.5">
          <span>📻</span>
          <span>Station & Song Presets ({stations.length})</span>
        </span>
        <span class="text-[9px] text-dracula-cyan">Click to tune in</span>
      </div>

      <!-- Search / Filter input -->
      <div class="mb-2">
        <input
          id="station-search-input"
          type="text"
          placeholder="Filter presets..."
          class="w-full bg-dracula-bgDarker border border-dracula-selection/60 rounded-lg px-2.5 py-1 text-[11px] text-dracula-fg placeholder:text-dracula-comment/60 focus:outline-none focus:border-dracula-purple"
        />
      </div>

      <!-- Scrollable Station List -->
      <div id="station-container" class="space-y-1.5 max-h-44 overflow-y-auto pr-1">
        {stations.map((st, idx) => (
          <button
            type="button"
            data-station-index={idx}
            class="station-item-btn w-full p-2 rounded-xl bg-dracula-card/60 hover:bg-dracula-selection/30 border border-dracula-selection/30 hover:border-dracula-cyan/50 flex items-center justify-between gap-2 text-left transition-all group focus:outline-none cursor-pointer"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="text-[9px] font-bold text-dracula-pink bg-dracula-pink/15 px-1.5 py-0.5 rounded w-14 text-center flex-shrink-0">
                {st.frequency}
              </span>
              <img
                src={st.logo}
                alt={st.name}
                class="w-8 h-8 rounded-lg object-cover bg-dracula-bgDarker flex-shrink-0"
                loading="lazy"
              />
              <div class="min-w-0">
                <span class="font-bold text-dracula-fg text-[11px] group-hover:text-dracula-cyan truncate block">
                  {st.name}
                </span>
                <span class="text-[10px] text-dracula-comment truncate block">
                  {st.genre}
                </span>
              </div>
            </div>

            <span class={
              st.type === "youtube"
                ? "text-[9px] px-1.5 py-0.5 rounded bg-dracula-red/20 text-dracula-red font-bold uppercase flex-shrink-0"
                : "text-[9px] px-1.5 py-0.5 rounded bg-dracula-purple/20 text-dracula-purple font-bold uppercase flex-shrink-0"
            }>
              {st.badge || (st.type === "youtube" ? "YouTube" : "Stream")}
            </span>
          </button>
        ))}
      </div>
    </div>

    <!-- Keyboard Shortcuts Legend -->
    <div class="mt-3 pt-2 border-t border-dracula-selection/20 flex items-center justify-between text-[9px] text-dracula-comment/70">
      <span>[Space] Play/Pause</span>
      <span>[M] Mute</span>
      <span>[←/→] Seek ±5s</span>
      <span>[J/K] Prev/Next</span>
    </div>
  </div>
</div>

<style>
  @keyframes miniEqKey1 { 0%, 100% { height: 3px; } 50% { height: 10px; } }
  @keyframes miniEqKey2 { 0%, 100% { height: 7px; } 50% { height: 2px; } }
  @keyframes miniEqKey3 { 0%, 100% { height: 2px; } 50% { height: 11px; } }
  @keyframes miniEqKey4 { 0%, 100% { height: 9px; } 50% { height: 4px; } }

  .mini-eq-playing .mini-eq-1 { animation: miniEqKey1 0.7s infinite ease-in-out; }
  .mini-eq-playing .mini-eq-2 { animation: miniEqKey2 0.5s infinite ease-in-out 0.1s; }
  .mini-eq-playing .mini-eq-3 { animation: miniEqKey3 0.8s infinite ease-in-out 0.2s; }
  .mini-eq-playing .mini-eq-4 { animation: miniEqKey4 0.6s infinite ease-in-out 0.3s; }
</style>

<script>
  interface RadioStation {
    id: string;
    name: string;
    genre: string;
    frequency: string;
    type: 'stream' | 'youtube';
    source: string;
    logo: string;
    description: string;
    badge: string;
    isLive?: boolean;
  }

  declare global {
    interface Window {
      onYouTubeIframeAPIReady?: () => void;
      YT?: any;
      draculaRadioToggle?: (forceState?: boolean) => void;
    }
  }

  function extractYouTubeVideoId(input: string): string {
    const trimmed = (input || '').trim();
    if (!trimmed) return '';
    if (/^[a-zA-Z0-9_-]{11}$/.test(trimmed)) return trimmed;

    const shortMatch = trimmed.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
    if (shortMatch) return shortMatch[1];

    const longMatch = trimmed.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
    if (longMatch) return longMatch[1];

    const embedMatch = trimmed.match(/youtube\.com\/(?:embed|v)\/([a-zA-Z0-9_-]{11})/);
    if (embedMatch) return embedMatch[1];

    return trimmed;
  }

  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  // Load Initial Stations
  const rootEl = document.getElementById('dracula-radio-root');
  let stations: RadioStation[] = [];
  try {
    stations = JSON.parse(rootEl?.getAttribute('data-stations') || '[]');
  } catch (e) {
    stations = [];
  }

  // Radio State
  const audioEl = document.getElementById('dracula-radio-audio') as HTMLAudioElement | null;
  let ytPlayer: any = null;
  let ytReady = false;
  let currentStationIndex = 0;
  let isPlaying = false;
  let isLoading = false;
  let isMuted = false;
  let volume = 0.75;
  let isDeckOpen = false;
  let isCurrentTrackLive = true;
  let pendingStationIndex: number | null = null;
  let progressTimer: any = null;
  let isUserSeeking = false;

  // Restore saved volume & station
  try {
    const savedVol = localStorage.getItem('dracula_radio_vol');
    if (savedVol !== null) volume = Math.max(0, Math.min(1, parseFloat(savedVol)));
    const savedStation = localStorage.getItem('dracula_radio_station');
    if (savedStation !== null) {
      const idx = parseInt(savedStation, 10);
      if (!isNaN(idx) && idx >= 0 && idx < stations.length) {
        currentStationIndex = idx;
      }
    }
  } catch (e) {}

  // DOM Elements
  const miniStationLogo = document.getElementById('mini-station-logo') as HTMLImageElement | null;
  const miniRadioWave = document.getElementById('mini-radio-wave');
  const miniStationFreq = document.getElementById('mini-station-freq');
  const miniStationName = document.getElementById('mini-station-name');
  const miniLiveBadge = document.getElementById('mini-live-badge');
  const miniLiveText = document.getElementById('mini-live-text');
  const miniEqualizer = document.getElementById('mini-equalizer');
  const miniPlayBtn = document.getElementById('mini-play-btn');
  const miniPlayIcon = document.getElementById('mini-play-icon');
  const miniPauseIcon = document.getElementById('mini-pause-icon');
  const miniLoadingIcon = document.getElementById('mini-loading-icon');
  const miniPrevBtn = document.getElementById('mini-prev-btn');
  const miniNextBtn = document.getElementById('mini-next-btn');
  const miniExpandBtn = document.getElementById('mini-expand-btn');
  const miniDeckToggleBtn = document.getElementById('mini-deck-toggle-btn');
  const miniProgressBar = document.getElementById('mini-progress-bar');

  const deckPanel = document.getElementById('radio-deck-panel');
  const deckCloseBtn = document.getElementById('deck-close-btn');
  const deckStatusPill = document.getElementById('deck-status-pill');
  const deckStatusDot = document.getElementById('deck-status-dot');
  const deckStatusText = document.getElementById('deck-status-text');

  const deckStationLogo = document.getElementById('deck-station-logo') as HTMLImageElement | null;
  const deckStationName = document.getElementById('deck-station-name');
  const deckStationGenre = document.getElementById('deck-station-genre');
  const deckStationDesc = document.getElementById('deck-station-desc');
  const deckBadge = document.getElementById('deck-badge');
  const deckLiveInfBadge = document.getElementById('deck-live-inf-badge');
  const deckFrequencyDisplay = document.getElementById('deck-frequency-display');

  const deckSeekSlider = document.getElementById('deck-seek-slider') as HTMLInputElement | null;
  const deckTimeCurrent = document.getElementById('deck-time-current');
  const deckTimeTotal = document.getElementById('deck-time-total');

  const deckPrevBtn = document.getElementById('deck-prev-btn');
  const deckPlayBtn = document.getElementById('deck-play-btn');
  const deckPlayIcon = document.getElementById('deck-play-icon');
  const deckPauseIcon = document.getElementById('deck-pause-icon');
  const deckLoadingIcon = document.getElementById('deck-loading-icon');
  const deckNextBtn = document.getElementById('deck-next-btn');

  const deckMuteBtn = document.getElementById('deck-mute-btn');
  const deckVolIconOn = document.getElementById('deck-vol-icon-on');
  const deckVolIconOff = document.getElementById('deck-vol-icon-off');
  const deckVolumeSlider = document.getElementById('deck-volume-slider') as HTMLInputElement | null;
  const deckVolumeLabel = document.getElementById('deck-volume-label');

  const stationContainer = document.getElementById('station-container');
  const stationSearchInput = document.getElementById('station-search-input') as HTMLInputElement | null;
  const customStationForm = document.getElementById('custom-station-form');
  const customStationInput = document.getElementById('custom-station-input') as HTMLInputElement | null;

  // --- YouTube IFrame API Setup ---
  function initYouTubeAPI() {
    if ((window as any).YT && (window as any).YT.Player) {
      createYouTubePlayer();
      return;
    }
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    const firstScriptTag = document.getElementsByTagName('script')[0];
    firstScriptTag?.parentNode?.insertBefore(tag, firstScriptTag);

    window.onYouTubeIframeAPIReady = () => {
      createYouTubePlayer();
    };
  }

  function createYouTubePlayer() {
    if (ytPlayer) return;
    try {
      ytPlayer = new (window as any).YT.Player('dracula-radio-yt-player', {
        height: '200',
        width: '200',
        playerVars: {
          autoplay: 0,
          controls: 0,
          disablekb: 1,
          fs: 0,
          modestbranding: 1,
          playsinline: 1,
          rel: 0,
          enablejsapi: 1,
        },
        events: {
          onReady: () => {
            ytReady = true;
            ytPlayer.setVolume(isMuted ? 0 : Math.round(volume * 100));
            if (pendingStationIndex !== null) {
              const idx = pendingStationIndex;
              pendingStationIndex = null;
              playStation(idx);
            } else if (isPlaying && stations[currentStationIndex]?.type === 'youtube') {
              playStation(currentStationIndex);
            }
          },
          onStateChange: (event: any) => {
            if (event.data === 1) { // Playing
              isLoading = false;
              isPlaying = true;
              checkIfLive();
              updateUI();
            } else if (event.data === 3) { // Buffering
              isLoading = true;
              updateUI();
            } else if (event.data === 5) { // Cued
              if (isPlaying) ytPlayer.playVideo();
            } else if (event.data === 0) { // Ended
              nextStation();
            }
          },
          onError: (event: any) => {
            console.warn('YouTube radio error code:', event.data);
            isLoading = false;
            if (event.data === 150 || event.data === 101 || event.data === 100 || event.data === 2) {
              setTimeout(() => {
                if (isPlaying) nextStation();
              }, 1200);
            } else {
              isPlaying = false;
              updateUI();
            }
          },
        },
      });
    } catch (e) {
      console.warn('YouTube Player initialization fallback:', e);
    }
  }

  initYouTubeAPI();

  // HTML5 Audio Event Listeners
  if (audioEl) {
    audioEl.volume = volume;
    audioEl.addEventListener('playing', () => {
      isLoading = false;
      isPlaying = true;
      checkIfLive();
      updateUI();
    });
    audioEl.addEventListener('waiting', () => {
      isLoading = true;
      updateUI();
    });
    audioEl.addEventListener('ended', () => {
      nextStation();
    });
    audioEl.addEventListener('error', () => {
      isLoading = false;
      isPlaying = false;
      updateUI();
    });
  }

  // Detect whether current playing track is a Live Stream (Infinity ∞) or Song
  function checkIfLive() {
    const station = stations[currentStationIndex];
    if (!station) return;

    if (station.type === 'stream') {
      isCurrentTrackLive = true;
      return;
    }

    if (station.type === 'youtube' && ytReady && ytPlayer) {
      try {
        const dur = ytPlayer.getDuration() || 0;
        const videoData = ytPlayer.getVideoData ? ytPlayer.getVideoData() : null;
        if (videoData && videoData.isLive) {
          isCurrentTrackLive = true;
        } else if (dur === 0 || !isFinite(dur)) {
          isCurrentTrackLive = true;
        } else {
          isCurrentTrackLive = false;
        }
      } catch (e) {
        isCurrentTrackLive = true;
      }
    }
  }

  // Play Station by Index
  function playStation(index: number) {
    if (index < 0 || index >= stations.length) return;
    currentStationIndex = index;
    try {
      localStorage.setItem('dracula_radio_station', String(index));
    } catch (e) {}

    const station = stations[index];
    if (!station) return;

    isLoading = true;
    isPlaying = true;
    checkIfLive();
    updateUI();

    if (station.type === 'youtube') {
      if (audioEl) {
        audioEl.pause();
        audioEl.src = '';
      }

      const videoId = extractYouTubeVideoId(station.source);
      if (ytReady && ytPlayer && ytPlayer.loadVideoById) {
        try {
          ytPlayer.setVolume(isMuted ? 0 : Math.round(volume * 100));
          ytPlayer.loadVideoById(videoId);
          ytPlayer.playVideo();
        } catch (err) {
          console.warn('loadVideoById error:', err);
        }
      } else {
        pendingStationIndex = index;
        initYouTubeAPI();
      }
    } else {
      if (ytReady && ytPlayer && ytPlayer.pauseVideo) {
        ytPlayer.pauseVideo();
      }

      if (audioEl && station.source) {
        audioEl.src = station.source;
        audioEl.volume = isMuted ? 0 : volume;
        audioEl.load();
        const p = audioEl.play();
        if (p) {
          p.catch((err) => {
            console.warn('Radio stream playback error:', err);
            isLoading = false;
            isPlaying = false;
            updateUI();
          });
        }
      }
    }
  }

  // Pause Station
  function pauseStation() {
    isPlaying = false;
    isLoading = false;

    if (audioEl) audioEl.pause();
    if (ytReady && ytPlayer && ytPlayer.pauseVideo) ytPlayer.pauseVideo();

    updateUI();
  }

  function togglePlay() {
    if (isPlaying) {
      pauseStation();
    } else {
      playStation(currentStationIndex);
    }
  }

  function nextStation() {
    const nextIdx = (currentStationIndex + 1) % stations.length;
    playStation(nextIdx);
  }

  function prevStation() {
    const prevIdx = (currentStationIndex - 1 + stations.length) % stations.length;
    playStation(prevIdx);
  }

  // Seek Progress
  function seekTo(percentage: number) {
    if (isCurrentTrackLive) return;
    const station = stations[currentStationIndex];
    if (!station) return;

    if (station.type === 'youtube' && ytReady && ytPlayer && ytPlayer.getDuration) {
      const dur = ytPlayer.getDuration() || 0;
      const targetSec = (percentage / 100) * dur;
      ytPlayer.seekTo(targetSec, true);
    }
  }

  function setVolume(newVol: number) {
    volume = Math.max(0, Math.min(1, newVol));
    try {
      localStorage.setItem('dracula_radio_vol', String(volume));
    } catch (e) {}

    if (isMuted && volume > 0) isMuted = false;

    if (audioEl) audioEl.volume = isMuted ? 0 : volume;
    if (ytReady && ytPlayer && ytPlayer.setVolume) {
      ytPlayer.setVolume(isMuted ? 0 : Math.round(volume * 100));
    }

    updateUI();
  }

  function toggleMute() {
    isMuted = !isMuted;
    if (audioEl) audioEl.volume = isMuted ? 0 : volume;
    if (ytReady && ytPlayer && ytPlayer.setVolume) {
      ytPlayer.setVolume(isMuted ? 0 : Math.round(volume * 100));
    }
    updateUI();
  }

  // Real-time progress timer loop
  function startProgressLoop() {
    if (progressTimer) clearInterval(progressTimer);
    progressTimer = setInterval(() => {
      if (!isPlaying) return;

      checkIfLive();
      const station = stations[currentStationIndex];
      if (!station) return;

      let cur = 0;
      let dur = 0;

      if (station.type === 'youtube' && ytReady && ytPlayer && ytPlayer.getCurrentTime) {
        cur = ytPlayer.getCurrentTime() || 0;
        dur = ytPlayer.getDuration() || 0;
      }

      if (isCurrentTrackLive || dur === 0) {
        // LIVE STREAM: Show Infinity ∞
        if (miniProgressBar) miniProgressBar.style.width = isPlaying ? '100%' : '0%';
        if (deckTimeCurrent) deckTimeCurrent.textContent = formatTime(cur);
        if (deckTimeTotal) deckTimeTotal.innerHTML = `<span>LIVE</span> <span class="text-sm font-extrabold text-dracula-pink">∞</span>`;
        if (deckSeekSlider) deckSeekSlider.value = '100';
      } else {
        // REGULAR SONG: Show progress & total duration
        const pct = Math.min(100, Math.max(0, (cur / dur) * 100));
        if (miniProgressBar) miniProgressBar.style.width = `${pct}%`;
        if (!isUserSeeking && deckSeekSlider) deckSeekSlider.value = String(pct);
        if (deckTimeCurrent) deckTimeCurrent.textContent = formatTime(cur);
        if (deckTimeTotal) deckTimeTotal.textContent = formatTime(dur);
      }
    }, 200);
  }
  startProgressLoop();

  // --- Accurate Rectangular Graphic Equalizer Canvas Engine ---
  const eqCanvas = document.getElementById('deck-eq-canvas') as HTMLCanvasElement | null;
  let eqCtx: CanvasRenderingContext2D | null = null;
  if (eqCanvas) {
    eqCtx = eqCanvas.getContext('2d');
  }

  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let sourceNode: MediaElementAudioSourceNode | null = null;
  let freqData: Uint8Array | null = null;

  function initWebAudio() {
    if (audioCtx || !audioEl) return;
    try {
      const AudioCtxClass = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtxClass) return;
      audioCtx = new AudioCtxClass();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 64;
      analyser.smoothingTimeConstant = 0.82;
      freqData = new Uint8Array(analyser.frequencyBinCount);

      sourceNode = audioCtx.createMediaElementSource(audioEl);
      sourceNode.connect(analyser);
      analyser.connect(audioCtx.destination);
    } catch (e) {}
  }

  const numColumns = 28;
  const peakLevels: number[] = new Array(numColumns).fill(0);
  const currentLevels: number[] = new Array(numColumns).fill(0.08);
  const peakHoldCounters: number[] = new Array(numColumns).fill(0);

  const segmentColors = [
    '#50fa7b', // L1 - Green (Low)
    '#50fa7b', // L2 - Green
    '#8be9fd', // L3 - Cyan
    '#f1fa8c', // L4 - Yellow (Mid)
    '#ffb86c', // L5 - Orange
    '#ff79c6', // L6 - Pink (Highs)
    '#bd93f9', // L7 - Purple
    '#ff5555', // L8 - Red (Peak Alert)
  ];

  function resizeCanvas() {
    if (!eqCanvas || !eqCtx) return;
    const rect = eqCanvas.getBoundingClientRect();
    if (rect.width === 0 || rect.height === 0) return;
    const dpr = window.devicePixelRatio || 1;
    eqCanvas.width = rect.width * dpr;
    eqCanvas.height = rect.height * dpr;
    eqCtx.resetTransform();
    eqCtx.scale(dpr, dpr);
  }

  window.addEventListener('resize', resizeCanvas);
  setTimeout(resizeCanvas, 150);

  function renderEqualizerFrame(timestamp: number) {
    if (eqCanvas && eqCtx) {
      const rect = eqCanvas.getBoundingClientRect();
      const width = rect.width;
      const height = rect.height;

      if (width > 0 && height > 0) {
        eqCtx.clearRect(0, 0, width, height);

        let hasLiveAudio = false;
        if (analyser && freqData && audioEl && !audioEl.paused) {
          analyser.getByteFrequencyData(freqData as any);
          hasLiveAudio = true;
        }

        const totalCols = numColumns;
        const gapX = 3;
        const colWidth = Math.max(3, Math.floor((width - (totalCols - 1) * gapX) / totalCols));
        const numSegments = 8;
        const gapY = 1.5;
        const segmentHeight = Math.max(2, Math.floor((height - (numSegments - 1) * gapY) / numSegments));
        const timeSec = timestamp / 1000;

        for (let c = 0; c < totalCols; c++) {
          let targetLevel = 0;

          if (isPlaying) {
            if (hasLiveAudio && freqData) {
              const binIndex = Math.min(freqData.length - 1, Math.floor((c / totalCols) * freqData.length));
              targetLevel = (freqData[binIndex] || 0) / 255;
            } else {
              const isBass = c < 7;
              const isMid = c >= 7 && c < 18;

              const kick = Math.pow(Math.sin(timeSec * 4.4 + 0.2), 6) * 0.9;
              const snare = Math.pow(Math.sin(timeSec * 2.2 + 0.8), 8) * 0.85;
              const hihat = Math.pow(Math.sin(timeSec * 8.8 + c * 0.4), 2) * 0.7;
              const melody = Math.sin(timeSec * 3.1 + c * 0.35) * 0.25 + 0.35;

              if (isBass) {
                targetLevel = Math.min(1, kick * 0.8 + melody * 0.3 + 0.1);
              } else if (isMid) {
                targetLevel = Math.min(1, snare * 0.75 + melody * 0.4 + 0.08);
              } else {
                targetLevel = Math.min(1, hihat * 0.65 + melody * 0.3 + 0.05);
              }

              targetLevel *= isMuted ? 0 : volume;
            }
          } else {
            targetLevel = 0.06;
          }

          if (targetLevel > currentLevels[c]) {
            currentLevels[c] += (targetLevel - currentLevels[c]) * 0.5;
          } else {
            currentLevels[c] += (targetLevel - currentLevels[c]) * 0.15;
          }

          const activeSegments = Math.round(currentLevels[c] * numSegments);

          if (activeSegments >= peakLevels[c]) {
            peakLevels[c] = activeSegments;
            peakHoldCounters[c] = 14;
          } else {
            if (peakHoldCounters[c] > 0) {
              peakHoldCounters[c]--;
            } else if (peakLevels[c] > 0) {
              peakLevels[c] -= 0.18;
            }
          }

          const x = c * (colWidth + gapX);

          // Stacked rectangular LED bricks
          for (let s = 0; s < numSegments; s++) {
            const y = height - (s + 1) * (segmentHeight + gapY);
            const isLit = s < activeSegments;
            const color = segmentColors[s] || '#ff79c6';

            if (isLit) {
              eqCtx.fillStyle = color;
              eqCtx.shadowColor = color;
              eqCtx.shadowBlur = 4;
              eqCtx.fillRect(x, y, colWidth, segmentHeight);
            } else {
              eqCtx.shadowBlur = 0;
              eqCtx.fillStyle = 'rgba(68, 71, 90, 0.25)';
              eqCtx.fillRect(x, y, colWidth, segmentHeight);
            }
          }

          // Top peak hold indicator
          const peakIdx = Math.min(numSegments - 1, Math.floor(peakLevels[c]));
          if (peakIdx > 0 && isPlaying) {
            const peakY = height - (peakIdx + 1) * (segmentHeight + gapY);
            const peakColor = segmentColors[peakIdx] || '#ff5555';
            eqCtx.fillStyle = peakColor;
            eqCtx.shadowColor = peakColor;
            eqCtx.shadowBlur = 6;
            eqCtx.fillRect(x, peakY, colWidth, segmentHeight);
          }
        }
        eqCtx.shadowBlur = 0;
      }
    }
    requestAnimationFrame(renderEqualizerFrame);
  }
  requestAnimationFrame(renderEqualizerFrame);

  // Custom YouTube/Stream Link Form Handler
  if (customStationForm && customStationInput) {
    customStationForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = customStationInput.value.trim();
      if (!val) return;

      const ytId = extractYouTubeVideoId(val);
      if (ytId && ytId.length === 11) {
        let videoTitle = `YouTube Track (${ytId})`;
        let videoAuthor = 'YouTube Audio';

        // Try no-auth oEmbed title fetch
        try {
          const res = await fetch(`https://noembed.com/embed?url=https://www.youtube.com/watch?v=${ytId}`);
          if (res.ok) {
            const data = await res.json();
            if (data && data.title) {
              videoTitle = data.title;
              if (data.author_name) videoAuthor = data.author_name;
            }
          }
        } catch (err) {}

        const newStation: RadioStation = {
          id: `custom-yt-${ytId}-${Date.now()}`,
          name: videoTitle,
          genre: videoAuthor,
          frequency: `${(88 + Math.random() * 20).toFixed(1)} FM`,
          type: 'youtube',
          source: ytId,
          logo: `https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`,
          description: `Custom YouTube tuned track (${videoAuthor})`,
          badge: 'YOUTUBE',
        };

        stations.unshift(newStation);
        customStationInput.value = '';
        renderStationItems();
        initWebAudio();
        playStation(0);
        return;
      }

      // Live Web Stream URL
      if (/^https?:\/\/.+/i.test(val)) {
        const newStation: RadioStation = {
          id: `custom-stream-${Date.now()}`,
          name: 'Live Web Stream',
          genre: 'Direct Audio Stream',
          frequency: `${(88 + Math.random() * 20).toFixed(1)} FM`,
          type: 'stream',
          source: val,
          logo: 'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=100&auto=format&fit=crop&q=60',
          description: 'Custom added live broadcast stream',
          badge: 'STREAM',
        };

        stations.unshift(newStation);
        customStationInput.value = '';
        renderStationItems();
        initWebAudio();
        playStation(0);
        return;
      }

      customStationInput.classList.add('border-dracula-red');
      setTimeout(() => customStationInput.classList.remove('border-dracula-red'), 1500);
    });
  }

  // Render Station Presets List
  function renderStationItems(filterQuery: string = '') {
    if (!stationContainer) return;
    const q = filterQuery.toLowerCase();

    stationContainer.innerHTML = '';
    stations.forEach((st, idx) => {
      if (q && !st.name.toLowerCase().includes(q) && !st.genre.toLowerCase().includes(q) && !st.frequency.toLowerCase().includes(q)) {
        return;
      }

      const isCurrent = idx === currentStationIndex;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-station-index', String(idx));
      btn.className = isCurrent
        ? 'station-item-btn w-full p-2 rounded-xl bg-dracula-purple/20 border border-dracula-purple text-left transition-all flex items-center justify-between gap-2 shadow-sm cursor-pointer'
        : 'station-item-btn w-full p-2 rounded-xl bg-dracula-card/60 hover:bg-dracula-selection/30 border border-dracula-selection/30 hover:border-dracula-cyan/50 flex items-center justify-between gap-2 text-left transition-all group focus:outline-none cursor-pointer';

      const badgeClass = st.type === 'youtube'
        ? 'text-[9px] px-1.5 py-0.5 rounded bg-dracula-red/20 text-dracula-red font-bold uppercase flex-shrink-0'
        : 'text-[9px] px-1.5 py-0.5 rounded bg-dracula-purple/20 text-dracula-purple font-bold uppercase flex-shrink-0';

      btn.innerHTML = `
        <div class="flex items-center gap-2.5 min-w-0">
          <span class="text-[9px] font-bold text-dracula-pink bg-dracula-pink/15 px-1.5 py-0.5 rounded w-14 text-center flex-shrink-0">
            ${st.frequency}
          </span>
          <img
            src="${st.logo}"
            alt="${st.name}"
            class="w-8 h-8 rounded-lg object-cover bg-dracula-bgDarker flex-shrink-0"
            loading="lazy"
          />
          <div class="min-w-0">
            <span class="font-bold text-dracula-fg text-[11px] group-hover:text-dracula-cyan truncate block">
              ${st.name}
            </span>
            <span class="text-[10px] text-dracula-comment truncate block">
              ${st.genre}
            </span>
          </div>
        </div>
        <span class="${badgeClass}">${st.badge || (st.type === 'youtube' ? 'YouTube' : 'Stream')}</span>
      `;

      stationContainer.appendChild(btn);
    });
  }

  // Filter Search
  if (stationSearchInput) {
    stationSearchInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value;
      renderStationItems(q);
    });
  }

  // Update UI State
  function updateUI() {
    const station = stations[currentStationIndex] || stations[0];
    if (!station) return;

    // Mini Pill Updates
    if (miniStationLogo) miniStationLogo.src = station.logo;
    if (miniStationFreq) miniStationFreq.textContent = station.frequency;
    if (miniStationName) miniStationName.textContent = station.name;

    if (miniRadioWave) {
      if (isPlaying) miniRadioWave.classList.remove('hidden');
      else miniRadioWave.classList.add('hidden');
    }

    if (miniLiveBadge && miniLiveText) {
      if (isCurrentTrackLive) {
        miniLiveText.textContent = 'LIVE ∞';
        miniLiveBadge.className = 'text-[9px] font-bold text-dracula-green flex items-center gap-0.5';
      } else {
        miniLiveText.textContent = 'SONG';
        miniLiveBadge.className = 'text-[9px] font-bold text-dracula-cyan flex items-center gap-0.5';
      }
    }

    if (miniEqualizer) {
      if (isPlaying) {
        miniEqualizer.classList.remove('opacity-40');
        miniEqualizer.classList.add('mini-eq-playing');
      } else {
        miniEqualizer.classList.add('opacity-40');
        miniEqualizer.classList.remove('mini-eq-playing');
      }
    }

    // Mini Play Icons
    if (miniPlayIcon && miniPauseIcon && miniLoadingIcon) {
      if (isLoading) {
        miniLoadingIcon.classList.remove('hidden');
        miniPlayIcon.classList.add('hidden');
        miniPauseIcon.classList.add('hidden');
      } else if (isPlaying) {
        miniLoadingIcon.classList.add('hidden');
        miniPlayIcon.classList.add('hidden');
        miniPauseIcon.classList.remove('hidden');
      } else {
        miniLoadingIcon.classList.add('hidden');
        miniPlayIcon.classList.remove('hidden');
        miniPauseIcon.classList.add('hidden');
      }
    }

    // Deck Metadata
    if (deckStationLogo) deckStationLogo.src = station.logo;
    if (deckStationName) deckStationName.textContent = station.name;
    if (deckStationGenre) deckStationGenre.textContent = station.genre;
    if (deckStationDesc) deckStationDesc.textContent = station.description;
    if (deckFrequencyDisplay) deckFrequencyDisplay.textContent = station.frequency;

    if (deckBadge) {
      if (station.type === 'youtube') {
        deckBadge.textContent = isCurrentTrackLive ? 'YOUTUBE LIVE' : 'YOUTUBE AUDIO';
        deckBadge.className = 'text-[9px] font-bold px-1.5 py-0.5 rounded bg-dracula-red/20 text-dracula-red border border-dracula-red/30 uppercase';
      } else {
        deckBadge.textContent = 'LIVE STREAM';
        deckBadge.className = 'text-[9px] font-bold px-1.5 py-0.5 rounded bg-dracula-purple/20 text-dracula-purple border border-dracula-purple/30 uppercase';
      }
    }

    if (deckLiveInfBadge) {
      if (isCurrentTrackLive) {
        deckLiveInfBadge.classList.remove('hidden');
      } else {
        deckLiveInfBadge.classList.add('hidden');
      }
    }

    // Status Pill
    if (deckStatusDot && deckStatusText && deckStatusPill) {
      if (isLoading) {
        deckStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-dracula-yellow animate-ping';
        deckStatusText.textContent = 'TUNING...';
        deckStatusPill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-dracula-yellow/20 border border-dracula-yellow/40 text-[10px] text-dracula-yellow';
      } else if (isPlaying) {
        deckStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-dracula-green animate-pulse';
        deckStatusText.textContent = isCurrentTrackLive ? 'ON AIR • ∞' : 'PLAYING';
        deckStatusPill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-dracula-green/20 border border-dracula-green/40 text-[10px] text-dracula-green';
      } else {
        deckStatusDot.className = 'w-1.5 h-1.5 rounded-full bg-dracula-comment';
        deckStatusText.textContent = 'STANDBY';
        deckStatusPill.className = 'flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-dracula-selection/40 border border-dracula-selection text-[10px] text-dracula-comment';
      }
    }

    // Deck Play/Pause Icons
    if (deckPlayIcon && deckPauseIcon && deckLoadingIcon) {
      if (isLoading) {
        deckLoadingIcon.classList.remove('hidden');
        deckPlayIcon.classList.add('hidden');
        deckPauseIcon.classList.add('hidden');
      } else if (isPlaying) {
        deckLoadingIcon.classList.add('hidden');
        deckPlayIcon.classList.add('hidden');
        deckPauseIcon.classList.remove('hidden');
      } else {
        deckLoadingIcon.classList.add('hidden');
        deckPlayIcon.classList.remove('hidden');
        deckPauseIcon.classList.add('hidden');
      }
    }

    // Deck Volume
    if (deckVolumeSlider) deckVolumeSlider.value = String(Math.round(volume * 100));
    if (deckVolumeLabel) deckVolumeLabel.textContent = isMuted ? '0%' : `${Math.round(volume * 100)}%`;
    if (deckVolIconOn && deckVolIconOff) {
      if (isMuted || volume === 0) {
        deckVolIconOn.classList.add('hidden');
        deckVolIconOff.classList.remove('hidden');
      } else {
        deckVolIconOn.classList.remove('hidden');
        deckVolIconOff.classList.add('hidden');
      }
    }

    // Update active highlight in station container
    const allStationBtns = document.querySelectorAll('.station-item-btn');
    allStationBtns.forEach((btn) => {
      const idx = parseInt(btn.getAttribute('data-station-index') || '-1', 10);
      if (idx === currentStationIndex) {
        btn.className = 'station-item-btn w-full p-2 rounded-xl bg-dracula-purple/20 border border-dracula-purple text-left transition-all flex items-center justify-between gap-2 shadow-sm cursor-pointer';
      } else {
        btn.className = 'station-item-btn w-full p-2 rounded-xl bg-dracula-card/60 hover:bg-dracula-selection/30 border border-dracula-selection/30 hover:border-dracula-cyan/50 flex items-center justify-between gap-2 text-left transition-all group focus:outline-none cursor-pointer';
      }
    });
  }

  function toggleDeck(forceState?: boolean) {
    if (typeof forceState === 'boolean') {
      isDeckOpen = forceState;
    } else {
      isDeckOpen = !isDeckOpen;
    }

    if (deckPanel) {
      if (isDeckOpen) {
        deckPanel.classList.remove('hidden');
        setTimeout(resizeCanvas, 50);
      } else {
        deckPanel.classList.add('hidden');
      }
    }
  }

  window.draculaRadioToggle = (forceState?: boolean) => {
    toggleDeck(forceState);
  };

  // Event Listeners
  if (miniDeckToggleBtn) miniDeckToggleBtn.addEventListener('click', () => toggleDeck());
  if (miniExpandBtn) miniExpandBtn.addEventListener('click', () => toggleDeck());
  if (deckCloseBtn) deckCloseBtn.addEventListener('click', () => toggleDeck(false));

  if (miniPlayBtn) {
    miniPlayBtn.addEventListener('click', () => {
      initWebAudio();
      togglePlay();
    });
  }
  if (deckPlayBtn) {
    deckPlayBtn.addEventListener('click', () => {
      initWebAudio();
      togglePlay();
    });
  }

  if (miniPrevBtn) miniPrevBtn.addEventListener('click', prevStation);
  if (deckPrevBtn) deckPrevBtn.addEventListener('click', prevStation);

  if (miniNextBtn) miniNextBtn.addEventListener('click', nextStation);
  if (deckNextBtn) deckNextBtn.addEventListener('click', nextStation);

  if (deckMuteBtn) deckMuteBtn.addEventListener('click', toggleMute);

  // Scrubber events
  if (deckSeekSlider) {
    deckSeekSlider.addEventListener('mousedown', () => { isUserSeeking = true; });
    deckSeekSlider.addEventListener('touchstart', () => { isUserSeeking = true; });

    deckSeekSlider.addEventListener('change', (e) => {
      isUserSeeking = false;
      const pct = parseFloat((e.target as HTMLInputElement).value);
      seekTo(pct);
    });
  }

  if (deckVolumeSlider) {
    deckVolumeSlider.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value) / 100;
      setVolume(val);
    });
  }

  // Frequency tick clicks
  document.addEventListener('click', (e) => {
    const tickBtn = (e.target as HTMLElement)?.closest('.freq-tick-btn');
    if (tickBtn) {
      const idx = parseInt(tickBtn.getAttribute('data-station-index') || '-1', 10);
      if (idx >= 0) {
        initWebAudio();
        playStation(idx);
      }
      return;
    }

    const stationBtn = (e.target as HTMLElement)?.closest('.station-item-btn');
    if (stationBtn) {
      const idx = parseInt(stationBtn.getAttribute('data-station-index') || '-1', 10);
      if (idx >= 0) {
        initWebAudio();
        playStation(idx);
      }
    }
  });

  // Global Keyboard Shortcuts
  window.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
    if (tag === 'input' || tag === 'textarea') return;

    if (e.code === 'Space' && isDeckOpen) {
      e.preventDefault();
      initWebAudio();
      togglePlay();
    } else if (e.key === 'm' || e.key === 'M') {
      if (isDeckOpen) toggleMute();
    } else if (e.key === 'j' || e.key === 'J') {
      if (isDeckOpen) prevStation();
    } else if (e.key === 'k' || e.key === 'K') {
      if (isDeckOpen) nextStation();
    } else if (e.code === 'ArrowRight' && isDeckOpen) {
      e.preventDefault();
      if (e.shiftKey) nextStation();
      else {
        const curPct = parseFloat(deckSeekSlider?.value || '0');
        seekTo(Math.min(100, curPct + 5));
      }
    } else if (e.code === 'ArrowLeft' && isDeckOpen) {
      e.preventDefault();
      if (e.shiftKey) prevStation();
      else {
        const curPct = parseFloat(deckSeekSlider?.value || '0');
        seekTo(Math.max(0, curPct - 5));
      }
    } else if (e.code === 'Escape' && isDeckOpen) {
      toggleDeck(false);
    }
  });

  // Initial Render
  updateUI();
</script>
