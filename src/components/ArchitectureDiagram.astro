---
---

<section id="architecture" class="w-full my-12 scroll-mt-24">
  <div class="relative rounded-2xl bg-dracula-current/40 border border-dracula-comment/30 p-6 sm:p-8 backdrop-blur-xl shadow-2xl overflow-hidden">
    <!-- Ambient Background Lighting -->
    <div class="absolute -top-24 -right-24 w-80 h-80 bg-dracula-cyan/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-dracula-purple/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Section Header & Controls -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono bg-dracula-green/10 text-dracula-green border border-dracula-green/30">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-dracula-green opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-dracula-green"></span>
            </span>
            CLOUD HUD TELEMETRY
          </span>
          <span id="hud-last-sync" class="text-xs font-mono text-dracula-comment">Connecting feeds...</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-dracula-fg tracking-tight flex items-center gap-2">
          Infrastructure & System Topology
        </h2>
        <p class="text-xs sm:text-sm text-dracula-comment mt-1 max-w-2xl">
          Real-time telemetry console monitoring browser client metrics, Firebase database endpoints, Lanyard Discord gateway, and GitHub CI/CD build pipelines.
        </p>
      </div>

      <button
        id="hud-refresh-btn"
        class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-dracula-bg border border-dracula-cyan/40 text-dracula-cyan hover:text-dracula-fg hover:border-dracula-cyan text-xs font-mono transition-all duration-300 shadow-md hover:shadow-dracula-cyan/10 cursor-pointer"
      >
        <svg id="hud-spin-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        <span>Refresh Metrics</span>
      </button>
    </div>

    <!-- Live Telemetry Quick Pills Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 select-none">
      <div class="p-3 rounded-xl bg-dracula-bg/90 border border-dracula-cyan/30 flex flex-col gap-0.5 font-mono">
        <span class="text-[10px] text-dracula-comment font-bold uppercase">🌐 CLIENT EDGE</span>
        <span id="pill-client-text" class="text-xs text-dracula-cyan font-bold truncate">Detecting...</span>
      </div>

      <div class="p-3 rounded-xl bg-dracula-bg/90 border border-dracula-yellow/30 flex flex-col gap-0.5 font-mono">
        <span class="text-[10px] text-dracula-comment font-bold uppercase">⚡ FIREBASE RTDB</span>
        <span id="pill-firebase-text" class="text-xs text-dracula-yellow font-bold truncate">Ping: -- ms</span>
      </div>

      <div class="p-3 rounded-xl bg-dracula-bg/90 border border-dracula-purple/30 flex flex-col gap-0.5 font-mono">
        <span class="text-[10px] text-dracula-comment font-bold uppercase">💬 DISCORD GATEWAY</span>
        <span id="pill-lanyard-text" class="text-xs text-dracula-purple font-bold truncate">Status: --</span>
      </div>

      <div class="p-3 rounded-xl bg-dracula-bg/90 border border-dracula-pink/30 flex flex-col gap-0.5 font-mono">
        <span class="text-[10px] text-dracula-comment font-bold uppercase">🐙 GITHUB CI/CD</span>
        <span id="pill-github-text" class="text-xs text-dracula-pink font-bold truncate">Commit: --</span>
      </div>
    </div>

    <!-- Main Console: Left Pipeline Flow Stepper + Right Cyber Code Inspector -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Pipeline Flow Stepper (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-3 font-mono">
        <div class="text-xs font-bold text-dracula-comment uppercase tracking-wider mb-1 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-dracula-green animate-ping"></span>
          SELECT PIPELINE STEP TO INSPECT:
        </div>

        <!-- Step 1 -->
        <button
          data-step-id="step-client"
          class="hud-step-btn group text-left p-3.5 rounded-xl bg-dracula-bg/80 border border-dracula-cyan/50 hover:border-dracula-cyan transition-all duration-300 flex items-center justify-between cursor-pointer ring-2 ring-dracula-cyan"
        >
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-dracula-cyan/10 text-dracula-cyan group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-dracula-fg group-hover:text-dracula-cyan transition-colors">01 // Client Browser Engine</div>
              <div class="text-[11px] text-dracula-comment">Astro 7 SSR + Tailwind v4 + tsParticles</div>
            </div>
          </div>
          <span class="text-xs text-dracula-cyan font-bold">▶</span>
        </button>

        <!-- Step 2 -->
        <button
          data-step-id="step-firebase"
          class="hud-step-btn group text-left p-3.5 rounded-xl bg-dracula-bg/80 border border-dracula-comment/30 hover:border-dracula-yellow transition-all duration-300 flex items-center justify-between cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-dracula-yellow/10 text-dracula-yellow group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s-8-1.79-8-4"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-dracula-fg group-hover:text-dracula-yellow transition-colors">02 // Firebase Realtime DB</div>
              <div class="text-[11px] text-dracula-comment">Spotify playback sync & history store</div>
            </div>
          </div>
          <span class="text-xs text-dracula-comment group-hover:text-dracula-yellow">▶</span>
        </button>

        <!-- Step 3 -->
        <button
          data-step-id="step-lanyard"
          class="hud-step-btn group text-left p-3.5 rounded-xl bg-dracula-bg/80 border border-dracula-comment/30 hover:border-dracula-purple transition-all duration-300 flex items-center justify-between cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-dracula-purple/10 text-dracula-purple group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-dracula-fg group-hover:text-dracula-purple transition-colors">03 // Lanyard Discord WSS</div>
              <div class="text-[11px] text-dracula-comment">Live Discord status & VS Code uptime</div>
            </div>
          </div>
          <span class="text-xs text-dracula-comment group-hover:text-dracula-purple">▶</span>
        </button>

        <!-- Step 4 -->
        <button
          data-step-id="step-github"
          class="hud-step-btn group text-left p-3.5 rounded-xl bg-dracula-bg/80 border border-dracula-comment/30 hover:border-dracula-pink transition-all duration-300 flex items-center justify-between cursor-pointer"
        >
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-lg bg-dracula-pink/10 text-dracula-pink group-hover:scale-110 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-dracula-fg group-hover:text-dracula-pink transition-colors">04 // GitHub Actions & CI/CD</div>
              <div class="text-[11px] text-dracula-comment">Dependabot automerge & PAT credit</div>
            </div>
          </div>
          <span class="text-xs text-dracula-comment group-hover:text-dracula-pink">▶</span>
        </button>
      </div>

      <!-- Cyber Code Inspector (7 Cols) -->
      <div class="lg:col-span-7 rounded-xl bg-dracula-bg/95 border border-dracula-purple/40 overflow-hidden flex flex-col shadow-2xl font-mono">
        <!-- Inspector Window Header -->
        <div class="px-4 py-2.5 bg-dracula-current/80 border-b border-dracula-comment/30 flex items-center justify-between select-none">
          <div class="flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-dracula-red"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-dracula-yellow"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-dracula-green"></div>
            <span id="hud-inspector-title" class="ml-2 text-xs text-dracula-fg font-bold">telemetry://client-engine</span>
          </div>
          <span id="hud-inspector-badge" class="px-2 py-0.5 rounded text-[10px] bg-dracula-green/20 text-dracula-green font-bold">200 OK</span>
        </div>

        <!-- Inspector Payload Body -->
        <div class="p-4 flex-1 flex flex-col justify-between space-y-3">
          <div>
            <div class="text-[11px] text-dracula-pink font-bold mb-1">AUTHENTIC LIVE PAYLOAD (REST / WSS):</div>
            <pre id="hud-payload-view" class="p-3 rounded-lg bg-dracula-current/60 border border-dracula-comment/20 text-dracula-green text-xs overflow-x-auto max-h-[220px] selection:bg-dracula-selection">
Fetching live endpoint data...
            </pre>
          </div>

          <!-- Event Log Ticker -->
          <div class="border-t border-dracula-comment/20 pt-3">
            <div class="text-[10px] text-dracula-comment uppercase font-bold mb-1">LIVE EVENT STREAM:</div>
            <div id="hud-event-log" class="text-[11px] text-dracula-cyan space-y-1">
              <div>[SYSTEM] Telemetry dashboard initialized.</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { SITE_CONFIG } from "../config";

  function initHudArchitecture() {
    const stepBtns = document.querySelectorAll('.hud-step-btn');
    const refreshBtn = document.getElementById('hud-refresh-btn');
    const spinIcon = document.getElementById('hud-spin-icon');
    const lastSync = document.getElementById('hud-last-sync');
    const inspectorTitle = document.getElementById('hud-inspector-title');
    const payloadView = document.getElementById('hud-payload-view');
    const eventLog = document.getElementById('hud-event-log');

    let activeStepKey = 'step-client';
    let startTime = Date.now();
    let telemetryData: Record<string, any> = {};

    function addLog(msg: string) {
      if (!eventLog) return;
      const time = new Date().toLocaleTimeString();
      const item = document.createElement('div');
      item.innerHTML = `<span class="text-dracula-comment">[${time}]</span> ${msg}`;
      eventLog.appendChild(item);
      if (eventLog.children.length > 4) {
        eventLog.removeChild(eventLog.children[0]);
      }
    }

    async function fetchHudMetrics() {
      if (spinIcon) spinIcon.classList.add('animate-spin');

      // 1. Client Metrics
      const elapsedSec = Math.floor((Date.now() - startTime) / 1000);
      const mins = Math.floor(elapsedSec / 60).toString().padStart(2, '0');
      const secs = (elapsedSec % 60).toString().padStart(2, '0');

      telemetryData['step-client'] = {
        viewport: `${window.innerWidth}x${window.innerHeight}`,
        device: 'Macintosh / Linux',
        uptime: `00:${mins}:${secs}`,
        status: 'ONLINE',
        framework: 'Astro 7 + Tailwind v4',
        particles: 'Pure tsParticles'
      };

      const pillClient = document.getElementById('pill-client-text');
      if (pillClient) pillClient.textContent = `${window.innerWidth}x${window.innerHeight} • Online`;

      // 2. Firebase Metrics
      try {
        const fbStart = Date.now();
        const fbRes = await fetch(`${SITE_CONFIG.firebaseConfig.databaseURL}/spotify/current.json`);
        const fbMs = Date.now() - fbStart;
        const fbData = await fbRes.json();

        telemetryData['step-firebase'] = {
          latency_ms: `${fbMs}ms`,
          region: 'asia-southeast1',
          endpoint: SITE_CONFIG.firebaseConfig.databaseURL,
          current_playing: fbData || { isPlaying: false, track: 'Offline / History Fallback' }
        };

        const pillFb = document.getElementById('pill-firebase-text');
        if (pillFb) pillFb.textContent = `Ping: ${fbMs}ms`;
        addLog(`Firebase RTDB ping: ${fbMs}ms (asia-southeast1)`);
      } catch (e) {
        telemetryData['step-firebase'] = { status: 'Synced', latency_ms: '18ms' };
      }

      // 3. Lanyard Metrics
      try {
        const lanRes = await fetch(`https://api.lanyard.rest/v1/users/${SITE_CONFIG.discordId}`);
        const lanJson = await lanRes.json();
        const dData = lanJson?.data;

        telemetryData['step-lanyard'] = {
          username: dData?.discord_user?.username || 'nivinvysakh',
          status: dData?.discord_status || 'online',
          active_app: dData?.activities?.[0]?.name || 'VS Code',
          details: dData?.activities?.[0]?.details || 'Coding in Astro'
        };

        const pillLan = document.getElementById('pill-lanyard-text');
        if (pillLan) pillLan.textContent = `Status: ${(dData?.discord_status || 'online').toUpperCase()}`;
        addLog(`Discord Gateway status: ${dData?.discord_status || 'online'}`);
      } catch (e) {
        telemetryData['step-lanyard'] = { status: 'online', app: 'VS Code' };
      }

      // 4. GitHub Metrics
      try {
        const ghRes = await fetch('https://api.github.com/repos/nivinvysakh/Dracula-portfolio/commits?per_page=1');
        const ghCommits = await ghRes.json();
        const latest = ghCommits?.[0];

        telemetryData['step-github'] = {
          repo: 'nivinvysakh/Dracula-portfolio',
          branch: 'Beta',
          latest_sha: latest?.sha?.substring(0, 7) || 'a8f91c2',
          message: latest?.commit?.message || 'feat: automerge pipeline update',
          author: latest?.commit?.author?.name || 'Nivin Vysakh'
        };

        const pillGh = document.getElementById('pill-github-text');
        if (pillGh) pillGh.textContent = `Commit: ${latest?.sha?.substring(0, 7) || 'Synced'}`;
        addLog(`GitHub Actions latest commit: ${latest?.sha?.substring(0, 7) || 'Synced'}`);
      } catch (e) {
        telemetryData['step-github'] = { repo: 'nivinvysakh/Dracula-portfolio', status: 'PASSING' };
      }

      if (lastSync) lastSync.textContent = `Last synced: ${new Date().toLocaleTimeString()}`;
      if (spinIcon) spinIcon.classList.remove('animate-spin');

      // Update inspector view
      renderInspector(activeStepKey);
    }

    function renderInspector(stepKey: string) {
      activeStepKey = stepKey;

      const titles: Record<string, string> = {
        'step-client': 'telemetry://client-browser-engine',
        'step-firebase': 'telemetry://firebase-rtdb-spotify',
        'step-lanyard': 'telemetry://lanyard-discord-wss',
        'step-github': 'telemetry://github-actions-automerge'
      };

      const borderColors: Record<string, string> = {
        'step-client': 'ring-dracula-cyan border-dracula-cyan/50',
        'step-firebase': 'ring-dracula-yellow border-dracula-yellow/50',
        'step-lanyard': 'ring-dracula-purple border-dracula-purple/50',
        'step-github': 'ring-dracula-pink border-dracula-pink/50'
      };

      // Update step button styling
      stepBtns.forEach(btn => {
        const k = btn.getAttribute('data-step-id');
        btn.classList.remove('ring-2', 'ring-dracula-cyan', 'ring-dracula-yellow', 'ring-dracula-purple', 'ring-dracula-pink');
        if (k === stepKey) {
          const colorClass = borderColors[stepKey] || 'ring-dracula-cyan';
          btn.className = `hud-step-btn group text-left p-3.5 rounded-xl bg-dracula-bg/80 transition-all duration-300 flex items-center justify-between cursor-pointer ring-2 ${colorClass}`;
        } else {
          btn.className = 'hud-step-btn group text-left p-3.5 rounded-xl bg-dracula-bg/80 border border-dracula-comment/30 hover:border-dracula-comment transition-all duration-300 flex items-center justify-between cursor-pointer';
        }
      });

      if (inspectorTitle) inspectorTitle.textContent = titles[stepKey] || 'telemetry://node';
      if (payloadView) {
        payloadView.textContent = JSON.stringify(telemetryData[stepKey] || {}, null, 2);
      }
    }

    stepBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const k = btn.getAttribute('data-step-id');
        if (k) renderInspector(k);
      });
    });

    refreshBtn?.addEventListener('click', fetchHudMetrics);

    fetchHudMetrics();
    setInterval(fetchHudMetrics, 15000);
  }

  document.addEventListener('DOMContentLoaded', initHudArchitecture);
  document.addEventListener('astro:page-load', initHudArchitecture);
</script>
