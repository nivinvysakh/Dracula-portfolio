<div id="tsparticles" class="fixed inset-0 pointer-events-none z-0"></div>

<script>
  import { tsParticles } from "@tsparticles/engine";
  import { loadSlim } from "@tsparticles/slim";

  async function initParticles() {
    try {
      console.log("Initializing Dracula Floating Sparks & Embers...");
      await loadSlim(tsParticles);

      await tsParticles.load({
        id: "tsparticles",
        options: {
          fullScreen: {
            enable: false,
          },
          fpsLimit: 120,
          interactivity: {
            detectsOn: "window",
            events: {
              onClick: {
                enable: true,
                mode: "push",
              },
              onHover: {
                enable: true,
                mode: "bubble",
              },
              resize: {
                enable: true,
              },
            },
            modes: {
              push: {
                quantity: 6,
              },
              bubble: {
                distance: 200,
                duration: 2,
                opacity: 1,
                size: 7,
              },
            },
          },
          particles: {
            color: {
              value: ["#f1fa8c", "#8be9fd", "#ff79c6", "#bd93f9", "#50fa7b", "#ffb86c"],
            },
            links: {
              enable: false,
            },
            move: {
              direction: "top",
              enable: true,
              outModes: {
                default: "out",
              },
              random: true,
              speed: { min: 0.8, max: 2.2 },
              straight: false,
            },
            number: {
              density: {
                enable: true,
                width: 1920,
                height: 1080,
              },
              value: 90,
            },
            opacity: {
              value: { min: 0.2, max: 0.95 },
              animation: {
                enable: true,
                speed: 2,
                sync: false,
              },
            },
            shape: {
              type: ["circle", "star"],
            },
            size: {
              value: { min: 1, max: 4 },
              animation: {
                enable: true,
                speed: 3,
                sync: false,
              },
            },
            twinkle: {
              particles: {
                enable: true,
                color: "#f1fa8c",
                frequency: 0.05,
                opacity: 1,
              },
            },
          },
          detectRetina: true,
        },
      });
      console.log("Dracula Floating Sparks loaded successfully!");
    } catch (err) {
      console.error("Error loading tsParticles sparks:", err);
    }
  }

  if (document.readyState === "complete" || document.readyState === "interactive") {
    initParticles();
  } else {
    document.addEventListener("DOMContentLoaded", initParticles);
  }
</script>
